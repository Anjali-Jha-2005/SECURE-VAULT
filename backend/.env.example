# Copy to .env and fill in. NEVER commit .env.
NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL=postgresql://securevault:SecureAI2026@localhost:5432/securevault?schema=public
# Separate database used ONLY by automated tests (name must contain "test")
DATABASE_URL_TEST=postgresql://securevault:SecureAI2026@localhost:5432/securevault_test?schema=public

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=nzt1g9wJOjJ5IVbcXCVg2uV5pB9aYabOME2wpNYqttvWL4nlkPM7mz2yU3x/6HWH
JWT_ISSUER=securevault
JWT_AUDIENCE=securevault-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
ABSOLUTE_SESSION_DAYS=30

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the API (0 = none). Needed for correct client IPs.
TRUST_PROXY=0
# Defaults to true in production, false otherwise
# COOKIE_SECURE=true

RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=300
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
LOG_LEVEL=info

# Used only by `npm run db:seed` (no defaults on purpose)
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=
